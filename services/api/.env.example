# Copy to .env for local runs. Never commit .env.
APP_VERSION=0.1.0
BUILD_NUMBER=0
MIN_APP_VERSION=0.1.0
# PostgreSQL address, for example postgresql://user:password@host/dbname
DATABASE_URL=
# A long random value. It signs the access tokens.
TOKEN_SECRET=change-me
# The password of the seeded admin `priveopapa`. Read by scripts/seed.py.
# MOCK_ADMIN_PASSWORD is read when this is not set.
ADMIN_PASSWORD=
# Dev only: seed a demo customer and a demo crew login.
SEED_DEMO_LOGINS=false
MOCK_CUSTOMER_PASSWORD=
MOCK_CREW_PASSWORD=
