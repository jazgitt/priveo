# Copy to .env for local runs. Never commit .env.
APP_VERSION=0.1.0
BUILD_NUMBER=0
MIN_APP_VERSION=0.1.0
# PostgreSQL address, for example postgresql://user:password@host/dbname
DATABASE_URL=
# A long random value (32+ characters). It signs the access tokens. There is no
# fallback: the server will not start without it.
TOKEN_SECRET=
# The password of the seeded admin `priveopapa`. Read by scripts/seed.py.
# MOCK_ADMIN_PASSWORD is read when this is not set.
ADMIN_PASSWORD=
# Dev only: seed a demo customer and a demo crew login.
SEED_DEMO_LOGINS=false
MOCK_CUSTOMER_PASSWORD=
MOCK_CREW_PASSWORD=
# "dev" or "prod", exactly. Dev and prod are separate deployments. A hosted server
# must set it on purpose; on your machine it defaults to dev. In prod the server
# will not start with SEED_DEMO_LOGINS, MOCK_*, EMAIL_REDIRECT_TO, or without
# RESEND_API_KEY and CRON_SECRET.
ENVIRONMENT=dev
# Dev only: optional fixed 6-digit code for verification and password reset.
# Without Resend, messages use the dev logging sender. Prod ignores this code.
MOCK_EMAIL_CODE=
# Set both to deliver email through a verified Resend sending domain.
# Prod verification fails closed when no provider key is configured.
RESEND_API_KEY=
EMAIL_FROM=Priveo <no-reply@priveo.in>
# Dev/testing: send every email to this one address (subject shows the real recipient).
EMAIL_REDIRECT_TO=
# Public address of this deployment, for links in admin emails.
PUBLIC_BASE_URL=

# Owner-approved mock business/integration values. Replace offline before live use.
MONEY_GST_RATE_PERCENT=18
# Mock tax split; choose CGST_SGST or IGST for the real invoice configuration.
MONEY_GST_MODE=CGST_SGST
MONEY_SELLER_NAME=Priveo (placeholder seller)
MONEY_SELLER_ADDRESS=Placeholder address, India
MONEY_SELLER_GSTIN=00PLACEHOLDER0Z0
MONEY_UPI_ID=priveo-placeholder@upi
MONEY_UPI_PAYEE_NAME=Priveo (placeholder)
MONEY_UPI_QR_URL=
SUPPORT_HELPLINE=+910000000000
SUPPORT_WHATSAPP=+910000000000
SUPPORT_HOURS=6 AM to 10 PM
TERMS_URL=https://example.com/priveo/terms
PRIVACY_URL=https://example.com/priveo/privacy
CRON_SECRET=
# Provider credentials intentionally blank; placeholders do not enable integrations.
FCM_ENABLED=false
FCM_PROJECT_ID=priveo-placeholder
FCM_CREDENTIALS_FILE=placeholder-firebase-service-account.json
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY_FILE=
MEDIA_STORE=local
S3_BUCKET=priveo-placeholder-media
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Existing RESEND_API_KEY and EMAIL_FROM entries remain authoritative.

# Set false only after replacing mock tax/supplier values for real use.
MONEY_GST_CONFIGURATION_MOCK=true
