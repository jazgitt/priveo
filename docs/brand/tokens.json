{
  "$comment": "Design tokens for Priveo. Source of truth for the Flutter theme and the Tailwind/shadcn theme. Mirrors section 6 of docs/tech-stack.md. Change both together.",
  "version": "0.1",
  "color": {
    "dark": {
      "ink": "#08080A",
      "app": "#0D0D10",
      "card": "#151519",
      "card2": "#1C1C21",
      "line": "#2A2925",
      "hair": "rgba(201,165,92,.20)",
      "text": "#F4F0E8",
      "mute": "#A39D92",
      "dim": "#6E695F",
      "grey": "#77736B",
      "gold": "#C9A55C",
      "goldHi": "#E9D09A",
      "goldLo": "#9C7A3A",
      "wine": "#7D1F2E",
      "wineHi": "#B0414F",
      "ok": "#62C391",
      "warn": "#E8A951",
      "info": "#6A97F2",
      "spa": "#BC8CF2",
      "error": "#F08F9B"
    },
    "light": {
      "app": "#F7F3EC",
      "card": "#FFFFFF",
      "line": "#E4DDD0",
      "text": "#16151A",
      "mute": "#6B665D",
      "gold": "#C9A55C",
      "goldText": "#8A6A2C",
      "wine": "#7D1F2E",
      "ok": "#2E9E6B",
      "warn": "#C98A2B",
      "info": "#3F6FD8",
      "spa": "#8A4FD0",
      "error": "#C0392B"
    },
    "button": {
      "primaryGradient": ["#EFD7A2", "#C9A55C", "#AD8743"],
      "primaryText": "#1B1408",
      "wineGradient": ["#9A2C3C", "#7D1F2E"]
    }
  },
  "font": {
    "display": {
      "family": "Cormorant Garamond",
      "fallback": ["Iowan Old Style", "Georgia", "serif"],
      "weights": [500, 600, 700],
      "italicWeights": [500],
      "minSize": 20
    },
    "body": {
      "family": "Manrope",
      "fallback": ["-apple-system", "Segoe UI", "Roboto", "sans-serif"],
      "weights": [400, 500, 600, 700, 800]
    },
    "scale": [11, 12, 13, 14, 16, 18, 22, 28]
  },
  "radius": {
    "input": 12,
    "cardSmall": 12,
    "card": 18,
    "sheet": 22,
    "button": 17,
    "avatar": "50%"
  },
  "component": {
    "buttonHeight": 56,
    "touchTargetMin": 48,
    "touchTargetCrew": 56,
    "pressedScale": 0.97,
    "pressedBrightness": 0.92,
    "motionMs": [150, 250],
    "textScaleSupported": 1.3,
    "icon": {
      "set": "Material Symbols Rounded",
      "strokeStyle": "outline",
      "weight": 1.5
    },
    "logo": {
      "file": "docs/brand/priveo-logo.png",
      "minWidth": 96
    }
  }
}
